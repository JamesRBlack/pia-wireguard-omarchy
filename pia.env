# PIA settings, read by pia-nm and pia-killswitch. Region ids: pia-nm --list
# Set by install.sh; change it and restart pia-vpn to switch server.
REGION=
# 1 = keep using the LAN DNS (e.g. a Pi-hole) while connected, instead of PIA's DNS
PIHOLE=0
# Local networks reachable even with the killswitch on. Several: quote them,
# e.g. LAN="192.168.50.0/24, 10.20.0.0/16". install.sh fills in the network
# you are on; empty = all private ranges.
LAN=
# 1 = VMs and containers are also blocked outside the tunnel
KS_FORWARD=1
