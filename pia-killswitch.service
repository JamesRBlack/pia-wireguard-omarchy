[Unit]
Description=PIA killswitch: block traffic outside the VPN tunnel
# Loads before NetworkManager brings any interface up, so nothing leaks at boot.
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/pia-killswitch on
ExecStop=/usr/local/bin/pia-killswitch off

[Install]
WantedBy=multi-user.target
